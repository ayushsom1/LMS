# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Judge0 Configuration (Optional)
# Option 1: Use the free public instance (rate limited, may be slow)
# Leave these empty or comment them out to use https://ce.judge0.com
#
# Option 2: Self-host Judge0 (recommended for production)
# JUDGE0_API_URL=http://localhost:2358
# JUDGE0_API_KEY=your-auth-token (optional)
#
# Option 3: Use RapidAPI (paid, but more reliable)
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your-rapidapi-key

# Resend Email Configuration (Optional)
# Get your API key from https://resend.com
RESEND_API_KEY=

# Admin Credentials
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=admin123
